# ------------------------------------------------------------------
# Example env vars — this file is committed (no real/sensitive values).
# To run locally, copy it to `.env.local` and fill in real values.
# ------------------------------------------------------------------

# Backend API base URL. Locally everything runs behind Nginx (port 80),
# which proxies to Django (internal port 8000), so the dev value is usually
# http://localhost.
VITE_API_BASE_URL=http://localhost

# If true, identity/index.ts serves mockApi instead of the real backend
# (useful for developing the UI without a live Django server).
VITE_USE_MOCK_API=false
