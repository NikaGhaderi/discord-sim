# ==============================
# Discord-Sim environment variables
#
# LOCAL DEV: copy this file to `.env` and run `make up` — every value below
# already works out of the box with docker-compose.yml, no edits needed.
#
# REAL SERVER: copy this file to `.env` on the target host and replace every
# value marked "CHANGE FOR PROD" below. Django reads all config through
# these variables, so no application code needs to change. The two things
# that are NOT controlled by this file are nginx's TLS/domain setup
# (nginx/nginx.conf) and which ports docker-compose exposes to the host
# (docker-compose.yml) — those still live in code, see README.md.
#
# Never commit the real .env file — only this .env.example is tracked.
# ==============================

# --- Django ---
DEBUG=True
# CHANGE FOR PROD: generate with `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=django-insecure-local-dev-only-8f3a1c9e2b7d4f6a0c5e8b1d3f7a9c2e
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CHANGE FOR PROD: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development
# CHANGE FOR PROD: comma-separated origin(s) of your deployed frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CHANGE FOR PROD: used to build links embedded in emails (e.g. password reset)
FRONTEND_BASE_URL=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=discord_sim
POSTGRES_USER=discord_sim_user
# CHANGE FOR PROD
POSTGRES_PASSWORD=discord_sim_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Email ---
# Local dev sends real SMTP mail to the mailpit service (docker-compose.yml)
# -- no credentials needed, view everything sent at http://localhost:8025.
# CHANGE FOR PROD: point at a real provider (SendGrid, SES, etc.) and set
# EMAIL_HOST_USER/EMAIL_HOST_PASSWORD/EMAIL_USE_TLS accordingly.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
# CHANGE FOR PROD: a real, deliverable "from" address
DEFAULT_FROM_EMAIL=noreply@discord-sim.local

# --- Media storage ---
# Local dev writes uploaded avatars/attachments to disk, served by nginx's
# /media/ location. On a plain single-container deploy (no nginx in front,
# e.g. Railway) nothing serves /media/ at all, and the container's disk
# isn't persisted across redeploys anyway. Set AWS_STORAGE_BUCKET_NAME (and
# the rest below) to switch to an S3-compatible bucket instead -- works with
# real AWS S3 or any S3-compatible provider (Cloudflare R2 recommended: free
# egress, generous free tier). Leave AWS_STORAGE_BUCKET_NAME empty to keep
# local dev on disk storage, unchanged.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
# Only needed for non-AWS providers, e.g. R2's
# https://<account_id>.r2.cloudflarestorage.com -- leave empty for real AWS S3.
AWS_S3_ENDPOINT_URL=
# Optional: a public bucket domain/CDN in front of the bucket, if you have one.
AWS_S3_CUSTOM_DOMAIN=

# --- Frontend ---
# CHANGE FOR PROD: your deployed API origin, e.g. https://api.discord-sim.com
# No /api suffix here -- every endpoint path in frontend/src/modules/*/api.ts
# already includes /api/... itself (matching backend/config/urls.py), so
# adding /api here would double it up and 404 every request.
VITE_API_BASE_URL=http://localhost
